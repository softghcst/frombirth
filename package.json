{
  "name": "pathways",
  "private": true,
  "type": "module",
  "description": "Pathways: a life simulation that runs in the browser. Nothing to install to play; these scripts are for development.",
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "fit-hair": "python scripts/fit_hair.py",
    "split-hair": "python scripts/split_batch.py && python scripts/fit_hair.py",
    "trace-hair": "python scripts/trace_hair_png.py && python scripts/fit_hair.py",
    "eye-template": "node scripts/make_eye_template.mjs",
    "trace-eyes": "python scripts/trace_eyes_png.py && python scripts/build-avatar-manifest.py",
    "soften-hair": "python scripts/soften_hair_lines.py && python scripts/fit_hair.py"
  }
}
